# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO VNSTOCK TELEGRAM BOT
# ==========================================

# 1. Telegram Bot Token (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Vnstock API Key (Lấy tại https://vnstocks.com)
VNSTOCK_API_KEY=your_vnstock_api_key_here

# 3. Google Gemini API Key (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Telegram Chat ID của Quản trị viên (để nhận tín hiệu Quant T0, T1, T3 tự động)
ADMIN_CHAT_ID=1021481711

# 5. Database Connection URL (Tùy chọn)
# Để trống để sử dụng SQLite cục bộ (bot_database.db), hoặc điền PostgreSQL / Supabase URL:
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# 6. Web Server Port (Dùng cho Health Check trên Render / Cloud Platform)
PORT=8080
